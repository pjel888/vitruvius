# Local operator secrets. Copy to .env and fill locally; never commit real keys.
VALYU_API_KEY=

# Production Neo4j promotion credentials. Fill only in an ignored local env file
# when running a separately approved live-promotion workflow; never commit values.
VITRUVIUS_PRODUCTION_NEO4J_URI=
VITRUVIUS_PRODUCTION_NEO4J_USER=
VITRUVIUS_PRODUCTION_NEO4J_PASSWORD=

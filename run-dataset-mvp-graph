#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

export PYTHONPATH="scripts${PYTHONPATH:+:$PYTHONPATH}"

if [[ $# -ge 2 && "$1" == "--profile" ]]; then
  exec python3 scripts/pipeline_cli.py run-completed-aggregate-from-profile "$@"
fi

exec python3 scripts/pipeline_cli.py run-completed-aggregate-family "$@"
